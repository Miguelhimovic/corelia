# Copiar a .env (fuera de Git, ver .gitignore) y completar con valores reales.
# SPEC.md seccion 8: secrets solo en variables de entorno, nunca en codigo ni en logs.

ENVIRONMENT=local

# Host 5544 -> en esta maquina de desarrollo el 5432 Y el 5433 ya estan
# ocupados por instancias nativas de PostgreSQL. Ver docker-compose.yml
# (servicio "db") y ajustar el puerto si tu maquina tiene otro conflicto.
DATABASE_URL=postgresql+psycopg2://corelia:corelia@localhost:5544/corelia

ANTHROPIC_API_KEY=
